# Copy to `.env.local` and fill in. Vite only exposes vars prefixed with VITE_.
# `.env.local` is git-ignored; never commit real credentials.

# Web3Forms access key. This is what makes contact-form submissions arrive in
# the company inbox automatically; without it the form falls back to the
# WhatsApp hand-over and never claims an email was delivered.
#
# Get one free at https://web3forms.com/#start — enter the inbox the enquiries
# should land in (geniewep@gmail.com) and the key is emailed to you. The key is
# public by design: it only ever delivers to that address.
VITE_WEB3FORMS_KEY=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=
