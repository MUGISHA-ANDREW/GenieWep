# Copy to `.env.local` and fill in. `.env.local` is git-ignored; never commit
# real credentials.
#
# Note which names carry a VITE_ prefix and which do not. Vite inlines every
# VITE_* var into the browser bundle, so anything secret must NOT have one.

# --- Contact form delivery (Resend) ------------------------------------------
# Read by `api/_enquiry.js`, which runs on the server: as a Vercel Serverless
# Function in production, and through the dev middleware in vite.config.js
# locally. Without RESEND_API_KEY the endpoint answers 503 and the form tells
# the visitor the message was not delivered.
#
# 1. Create a key at https://resend.com/api-keys (Sending access is enough).
# 2. Verify geniewep.com at https://resend.com/domains and set RESEND_FROM to
#    an address on it. Until then, leave RESEND_FROM unset: the default is
#    Resend's shared onboarding sender, which ONLY delivers to the email that
#    owns the Resend account. Fine for a smoke test, useless for real enquiries.
# 3. On Vercel, add these under Settings -> Environment Variables (Production
#    and Preview). They are read at request time, so no rebuild is needed.
RESEND_API_KEY=
RESEND_FROM=GenieWep Website <website@geniewep.com>

# Where enquiries land. Defaults to CONTACT.email in src/utils/constants.js.
ENQUIRY_TO=geniewep@gmail.com

# --- Analytics ---------------------------------------------------------------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=
