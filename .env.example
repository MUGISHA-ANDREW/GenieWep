# Copy to `.env.local` and fill in. `.env.local` is git-ignored; never commit
# real credentials.
#
# Note which names carry a VITE_ prefix and which do not. Vite inlines every
# VITE_* var into the browser bundle, so anything secret must NOT have one.
# RESEND_API_KEY is unprefixed for exactly that reason.

# --- Contact form delivery (Resend) ------------------------------------------
# The contact form POSTs to /api/send-enquiry, which emails the enquiry to
# geniewep@gmail.com. That address is the default and comes from CONTACT.email
# in src/utils/constants.js — it does not need to be set here.
#
# Read by `api/_enquiry.js`, which runs on the server: as a Vercel Serverless
# Function in production, and through the dev middleware in vite.config.js
# locally. Without RESEND_API_KEY the endpoint answers 503, and the form tells
# the visitor the message did not send and offers WhatsApp instead. Nothing is
# silently dropped.
#
# ── The quickest way to make it live (no DNS, about five minutes) ────────────
# 1. Sign up at https://resend.com USING geniewep@gmail.com as the account
#    email. This matters: the shared sender below can only deliver to the
#    address that owns the Resend account. Sign up with that address and
#    enquiries reach that inbox immediately, with no domain to verify.
# 2. Create a key at https://resend.com/api-keys (Sending access is enough)
#    and paste it into RESEND_API_KEY.
# 3. Leave RESEND_FROM unset. It defaults to Resend's shared sender, which is
#    what makes step 1 work.
# 4. On Vercel, add RESEND_API_KEY under Settings -> Environment Variables for
#    Production and Preview. It is read at request time, so no rebuild is
#    needed — just redeploy once so the function picks it up.
#
# ── Later, to send from your own domain ──────────────────────────────────────
# Verify geniewep.com at https://resend.com/domains (a few DNS records), then
# set RESEND_FROM to an address on it. Only do this once the domain is
# verified: an unverified sender domain makes Resend reject every message, and
# the form will report a delivery failure on a site that was working.
RESEND_API_KEY=

# Optional. Leave blank until the sending domain is verified — see above.
# RESEND_FROM=GenieWep Website <website@geniewep.com>

# Optional. Overrides where enquiries land; defaults to geniewep@gmail.com.
# ENQUIRY_TO=geniewep@gmail.com

# --- Visitor confirmation email (Gmail) --------------------------------------
# After an enquiry arrives, the visitor gets "your message was received, we
# will contact you in less than 24 hours". Resend cannot send that to visitors
# until a domain is verified, so it goes through Gmail instead when these are
# set. Without them, only the company inbox gets an email.
#
# GMAIL_APP_PASSWORD is NOT the Gmail login password. Create one at
# https://myaccount.google.com/apppasswords (2-Step Verification must be on).
# Add both to Vercel too, like RESEND_API_KEY.
GMAIL_USER=geniewep@gmail.com
GMAIL_APP_PASSWORD=

# --- Analytics ---------------------------------------------------------------
# Not wired up, and deliberately so: the cookie policy states the site sets no
# analytics or advertising cookies, and src/test/routes.test.jsx asserts it.
# Adding a tag means updating both, and adding a consent banner.
# VITE_GA_MEASUREMENT_ID=
